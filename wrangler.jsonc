{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "marriedbyjake",
  "account_id": "60ef6bd2c48d5beb6fd6a093cff863cf",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "404-page"
  },
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "marriedbyjake-emdash",
      "database_id": "a9e0e146-602f-411c-b9d7-a46be3299f3a"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "marriedbyjake-emdash-media"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "vars": {
    "EMDASH_SITE_URL": "https://marriedbyjake.com",
    "PUBLISHING_ENABLED": "false",
    "PUBLISHING_BASELINE_HASH": "3158d456870422bb250fc299720e3d252dd6bfb477dcc7cae59013a2ed2e2e81",
    "GITHUB_APP_ID": "5343818",
    "GITHUB_INSTALLATION_ID": "172038461",
    "GITHUB_REPOSITORY_ID": "1104160905"
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true
  },
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "8fa1ec227c9a446390a6299856e15f6e"
    }
  ],
  "routes": [
    {
      "pattern": "marriedbyjake.com/*",
      "zone_id": "240f3283c1efa4405979f3bda0c5896e"
    },
    {
      "pattern": "www.marriedbyjake.com/*",
      "zone_id": "240f3283c1efa4405979f3bda0c5896e"
    }
  ]
}
