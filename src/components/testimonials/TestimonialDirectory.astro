---
import PublishedImage from "@/components/content/PublishedImage.astro";
import {websiteSection} from '@/lib/website';
import WebsiteText from '@/components/content/WebsiteText.astro';
const section = await websiteSection('testimonials-intro');

import { imagePosition } from "@/lib/media-position";
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import { Image } from "astro:assets";
// Content
import { getCollection } from "@/lib/cms";
const allTestimonials = await getCollection("weddingtestimonials");
import { paginateTestimonials, testimonialPageUrl as pageUrl } from "@/lib/testimonial-pagination";
import LocationsMap from "@/components/testimonials/LocationsMap.astro";

const { featuredTestimonials, otherTestimonialsWithImages, otherTestimonialsWithoutImages,
  page, pageCount, total, start, end } = paginateTestimonials(allTestimonials, String(Astro.props.pageNumber || 1));
const excerpt = (s: string, n = 180) => {
  const t = (s || "")
    .replace(/^#+\s+/gm, "")
    .replace(/!\[.*?\]\(.*?\)/g, "")
    .replace(/\[([^\]]+)\]\([^\)]+\)/g, "$1")
    .replace(/[*_]{1,3}(.*?)[*_]{1,3}/g, "$1")
    .replace(/^\s*>\s*/gm, "")
    .replace(/`{3}[\s\S]*?`{3}/g, "")
    .replace(/`(.+?)`/g, "$1")
    .replace(/^\s*[-*_]{3,}\s*$/gm, "")
    .replace(/\s+/g, " ")
    .trim();
  return t.slice(0, n) + (t.length > n ? "…" : "");
};
const formatDate = (d?: Date) =>
  d
    ? new Date(d).toLocaleDateString("en-AU", {
        year: "numeric",
        month: "long",
        day: "numeric",
      })
    : null;
---

<BaseLayout
  title="Married By Jake Testimonials"
  canonical={pageUrl(page)}
  description="Read real wedding testimonials from couples married by Jake Smith across Brisbane, South East Queensland, Australia and destination weddings."
>
  <Fragment slot="head">
    {page > 1 && <link rel="prev" href={pageUrl(page - 1)} />}
    {page < pageCount && <link rel="next" href={pageUrl(page + 1)} />}
  </Fragment>
  <section>
    <Wrapper variant="standard" class="pb-12 pt-48">
      <div class="max-width mb-2">
        {section.image?.id && <PublishedImage node={{_type:'image',asset:{_ref:section.image.id},alt:section.image.alt||section.heading}}/>}
<Text
          tag="h1"
          variant="displayLG"
          class="text-accent-800 font-display text-center"
        >{section.eyebrow && <span class="block text-sm font-sans mb-2">{section.eyebrow}</span>}{section.heading}</Text>
        <Text tag="p" variant="textSM" class="text-base-600 text-center mt-2"><WebsiteText inline value={[section.body[0]]} /></Text>
      </div>

      <!-- Featured Testimonials -->
      {featuredTestimonials.length > 0 && (
        <div class="grid grid-cols-1 lg:grid-cols-2 mt-12 gap-8 mb-12">
          {featuredTestimonials.map((t) => (
            <article class="relative group overflow-hidden grid grid-cols-1 lg:grid-cols-2">
              <a href={`/weddingtestimonials/${t.id}`} class="absolute inset-0 z-10" aria-label={`Read testimonial from ${t.data.coupleName}`}></a>
              {t.data.image?.url && (
                <Image
                  width={1000}
                  sizes="(min-width: 1024px) calc((100vw - 224px) / 4), (min-width: 768px) calc(100vw - 96px), calc(100vw - 64px)"
                  src={t.data.image.url}
            style={imagePosition(t.data.image)}
                  widths={[320, 640, 1000]}
                  alt={t.data.image.alt || t.data.coupleName}
                  class="object-cover w-full aspect-square object-top transition-transform duration-300 group-hover:scale-[1.02]"
                  loading="lazy"
                  decoding="async"
                />
              )}
              <div class="p-8 bg-base-50 flex flex-col h-full justify-between gap-4">
                <div>
                  <Text tag="h3" variant="displaySM" class="text-accent-800 font-display">
                    {t.data.coupleName}
                  </Text>
                  <Text tag="p" variant="textSM" class="text-base-700 mt-1">
                    {t.data.venue} · {t.data.location}
                  </Text>
                  {t.data.pubDate && (
                    <Text tag="p" variant="textXS" class="text-base-600 mt-1">
                      {formatDate(t.data.pubDate)}
                    </Text>
                  )}
                  <Text tag="p" variant="textSM" class="text-base-700 mt-3">
                    {"★".repeat(t.data.rating)} {excerpt(t.body ?? "")}
                  </Text>
                </div>
              </div>
            </article>
          ))}
        </div>
      )}

      {page === 1 && <LocationsMap />}
      
      <div class="grid grid-cols-1 lg:grid-cols-2 mt-12 lg:mt-24 gap-8">
        {otherTestimonialsWithImages.map((t) => (
          <article class="relative group overflow-hidden grid grid-cols-1 lg:grid-cols-2">
            <a href={`/weddingtestimonials/${t.id}`} class="absolute inset-0 z-10" aria-label={`Read testimonial from ${t.data.coupleName}`}></a>
            {t.data.image?.url && (
              <Image
                width={1000}
                sizes="(min-width: 1024px) calc((100vw - 224px) / 4), (min-width: 768px) calc(100vw - 96px), calc(100vw - 64px)"
                src={t.data.image.url}
            style={imagePosition(t.data.image)}
                  widths={[320, 640, 1000]}
                alt={t.data.image.alt || t.data.coupleName}
                class="object-cover w-full aspect-square object-top transition-transform duration-300 group-hover:scale-[1.02]"
                loading="lazy"
                decoding="async"
              />
            )}
            <div class="p-8 bg-base-50 flex flex-col h-full justify-between gap-4">
              <div>
                <Text tag="h3" variant="displaySM" class="text-accent-800 font-display">
                  {t.data.coupleName}
                </Text>
                <Text tag="p" variant="textSM" class="text-base-700 mt-1">
                  {t.data.venue} · {t.data.location}
                </Text>
                {t.data.pubDate && (
                  <Text tag="p" variant="textXS" class="text-base-600 mt-1">
                    {formatDate(t.data.pubDate)}
                  </Text>
                )}
                <Text tag="p" variant="textSM" class="text-base-700 mt-3">
                  {"★".repeat(t.data.rating)} {excerpt(t.body ?? "")}
                </Text>
              </div>
            </div>
          </article>
        ))}

        {otherTestimonialsWithoutImages.map((t) => (
          <article class="relative group overflow-hidden bg-base-50">
            <a href={`/weddingtestimonials/${t.id}`} class="absolute inset-0 z-10" aria-label={`Read testimonial from ${t.data.coupleName}`}></a>
            <div class="p-8 flex flex-col h-full justify-between gap-4">
              <div>
                <Text tag="h3" variant="displaySM" class="text-accent-800 font-display">
                  {t.data.coupleName}
                </Text>
                <Text tag="p" variant="textSM" class="text-base-700 mt-1">
                  {t.data.venue} · {t.data.location}
                </Text>
                {t.data.pubDate && (
                  <Text tag="p" variant="textXS" class="text-base-600 mt-1">
                    {formatDate(t.data.pubDate)}
                  </Text>
                )}
                <Text tag="p" variant="textSM" class="text-base-700 mt-3">
                  {"★".repeat(t.data.rating)} {excerpt(t.body ?? "")}
                </Text>
              </div>
            </div>
          </article>
        ))}
      </div>
      <nav aria-label="Testimonial pages" class="mt-12 text-base-700">
        <div class="flex flex-wrap items-center justify-center gap-4">
          {page > 1 && <a rel="prev" href={pageUrl(page - 1)} class="page-link border border-base-300 px-4 py-3 hover:bg-base-50">Previous</a>}
          <p class="text-sm text-center">Reviews {start}–{end} of {total} · Page {page} of {pageCount}</p>
          {page < pageCount && <a rel="next" href={pageUrl(page + 1)} class="page-link border border-base-300 px-4 py-3 hover:bg-base-50">Next</a>}
        </div>
        <ul class="flex flex-wrap justify-center gap-2 mt-6">
          {Array.from({ length: pageCount }, (_, index) => index + 1).map(number => (
            <li><a href={pageUrl(number)} aria-label={`Testimonial page ${number}`} aria-current={number === page ? "page" : undefined}
              class:list={["page-link flex size-11 items-center justify-center rounded-full border", number === page ? "bg-accent-800 text-white border-accent-800" : "border-base-300 hover:bg-base-50"]}>{number}</a></li>
          ))}
        </ul>
      </nav>
    </Wrapper>
  </section>
</BaseLayout>

<style>
  .page-link:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
</style>
