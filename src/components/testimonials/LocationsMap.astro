---
import { getCollection } from "@/lib/cms";
import { testimonialMapLocations } from "@/lib/testimonial-map";
const testimonials = await getCollection("weddingtestimonials");
const locationsData = testimonialMapLocations(testimonials);
const API_KEY = import.meta.env.PUBLIC_GOOGLE_MAPS_API_KEY || "";
---

<div class="relative w-full h-[600px] bg-base-100 overflow-hidden shadow-sm z-0 mt-20">
  <div id="google-map" class="absolute inset-0 z-0 w-full h-full"></div>
  
  { !API_KEY && (
    <div class="absolute inset-0 z-10 flex items-center justify-center bg-black/50 text-white pointer-events-none">
      <div class="bg-red-600 p-4 shadow-lg text-center">
        <p class="font-bold">Google Maps API Key Missing</p>
        <p class="text-sm">Please add PUBLIC_GOOGLE_MAPS_API_KEY to your .env file</p>
      </div>
    </div>
  )}
</div>

<script is:inline define:vars={{ locationsData, API_KEY }}>
  // @ts-nocheck -- Google supplies this loader as browser-ready JavaScript.
  // Dynamic Google Maps Loader
  if (API_KEY) {
    (g=>{var h,a,k,p="The Google Maps JavaScript API",c="google",l="importLibrary",q="__ib__",m=document,b=window;b=b[c]||(b[c]={});var d=b.maps||(b.maps={}),r=new Set,e=new URLSearchParams,u=()=>h||(h=new Promise((f,n)=>{a=m.createElement("script");e.set("libraries",[...r]+"");for(k in g)e.set(k.replace(/[A-Z]/g,t=>"_"+t[0].toLowerCase()),g[k]);e.set("callback",c+".maps."+q);a.src=`https://maps.${c}apis.com/maps/api/js?`+e;d[q]=f;a.onerror=()=>h=n(Error(p+" could not load."));a.nonce=m.querySelector("script[nonce]")?.nonce||"";m.head.append(a)}));d[l]?console.warn(p+" only loads once. Ignoring:",g):d[l]=(f,...n)=>r.add(f)&&u().then(()=>d[l](f,...n))})({
      key: API_KEY,
      v: "weekly",
    });
  }

  function escapeHtml(value) {
    return String(value).replace(/[&<>"']/g, (character) => ({
      "&": "&amp;",
      "<": "&lt;",
      ">": "&gt;",
      '"': "&quot;",
      "'": "&#039;",
    })[character]);
  }

  async function initMap() {
    if (!API_KEY) {
        console.error("Google Maps API Key is missing. Map will not load correctly.");
        return;
    }

    try {
        const { Map } = await google.maps.importLibrary("maps");
        const { Marker } = await google.maps.importLibrary("marker"); // Use standard Marker for broader compatibility

        const mapElement = document.getElementById("google-map");
        if (!mapElement) return;

        // Default to Brisbane
        const map = new Map(mapElement, {
          center: { lat: -27.4698, lng: 153.0251 },
          zoom: 9,
          mapId: "WEDDING_LOCATIONS_MAP", // Optional, enables cloud styling if configured
          disableDefaultUI: false,
          zoomControl: true,
          mapTypeControl: false,
          streetViewControl: false,
          fullscreenControl: true,
        });

        const infoWindow = new google.maps.InfoWindow({ maxWidth: 360 });
        const bounds = new google.maps.LatLngBounds();
        let count = 0;

        // Parse locations
        const data = locationsData;
        
        Object.entries(data).forEach(([name, loc]) => {
          if (loc && typeof loc.lat === 'number' && typeof loc.lon === 'number') {
            const position = { lat: loc.lat, lng: loc.lon };
            const safeName = escapeHtml(name);
            
            const marker = new Marker({
              map,
              position: position,
              title: name,
              optimized: false, // Google requires this for keyboard-accessible legacy markers.
              animation: google.maps.Animation.DROP,
            });

            marker.addListener("click", () => {
              const reviews = loc.reviews || [];
              const reviewLinks = reviews.length
                ? `<ul aria-label="Wedding reviews" class="space-y-1">${reviews.map(([slug, coupleName]) => `
                    <li><a href="/weddingtestimonials/${escapeHtml(slug)}" class="block min-h-11 py-2 text-sm text-accent-800 underline focus-visible:outline-2 focus-visible:outline-offset-2">${coupleName === "Wedding review" ? "Read wedding review" : `Read ${escapeHtml(coupleName)}’s review`}</a></li>
                  `).join("")}</ul>`
                : '<a href="/weddingtestimonials" class="block min-h-11 py-2 text-sm text-accent-800 underline focus-visible:outline-2 focus-visible:outline-offset-2">Browse all wedding reviews</a>';
              infoWindow.close();
              infoWindow.setOptions({ ariaLabel: `Wedding reviews at ${name}` });
              infoWindow.setContent(`
                <div class="p-2 max-w-xs max-h-64 overflow-y-auto">
                    <h2 class="font-bold text-lg text-accent-800 mb-1">${safeName}</h2>
                    ${reviewLinks}
                    <a href="https://www.google.com/maps/dir/?api=1&destination=${loc.lat},${loc.lon}"
                       target="_blank" 
                       rel="noopener noreferrer"
                       class="inline-block min-h-11 py-2 mt-2 text-xs text-base-700 underline focus-visible:outline-2 focus-visible:outline-offset-2">
                       Directions on Google Maps (opens in a new tab)
                    </a>
                </div>
              `);
              infoWindow.open({ map, anchor: marker, shouldFocus: true });
            });

            bounds.extend(position);
            count++;
          }
        });

        console.log(`Added ${count} markers to Google Map`);

        if (count > 0) {
          map.fitBounds(bounds);
          // Adjust zoom if too close (single point)
          const listener = google.maps.event.addListener(map, "idle", () => { 
            if (map.getZoom() > 15) map.setZoom(15); 
            google.maps.event.removeListener(listener); 
          });
        }
    } catch (error) {
        console.error("Error initializing Google Map:", error);
    }
  }

  // Load Maps and build markers only when the map approaches the viewport.
  function observeMap() {
    const element = document.getElementById("google-map");
    if (!element || element.dataset.mapObserved) return;
    element.dataset.mapObserved = "true";
    if (!("IntersectionObserver" in window)) {
      initMap();
      return;
    }
    const observer = new IntersectionObserver((entries) => {
      if (!entries.some((entry) => entry.isIntersecting)) return;
      observer.disconnect();
      initMap();
    }, { rootMargin: "200px" });
    observer.observe(element);
  }
  observeMap();
  document.addEventListener("astro:page-load", observeMap);
</script>
