---
import {PortableText} from 'emdash/ui';
import InlineBlock from './InlineBlock.astro';
import PublishedImage from './PublishedImage.astro';
import PublishedGallery from './PublishedGallery.astro';
import {canonicalContentLinks} from '@/lib/internal-links';
const {value=[],inline=false}=Astro.props;
---
<PortableText value={canonicalContentLinks(value)} components={{...(inline?{block:{normal:InlineBlock}}:{}),type:{image:PublishedImage,gallery:PublishedGallery}}} />
