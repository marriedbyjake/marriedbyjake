---
import seo from "@/data/seo.json";
import {pageSearch,contentSearch,siteSettings,websiteImage} from "@/lib/website";
const fallbackSocialImage={src:"/og-image.jpg",width:1200,height:630,format:"jpg" as const};
const {
  title,
  description,
  canonical: userCanonical,
  image,
  video,
  ogType = "website",
} = Astro.props as {
  title?: string;
  description?: string;
  canonical?: string;
  image?:
    | string
    | {
        url: string;
        alt?: string;
        width?: number;
        height?: number;
        type?: string;
      };
  video?: string;
  ogType?: string;
};

const defaultTitle = "Married by Jake";
const defaultDescription =
  "Jake Smith is a warm, trusted civil marriage celebrant helping couples create meaningful, personal wedding ceremonies for all backgrounds across Australia.";
// File-format build paths are implementation details; public URLs stay clean.
const builtPath = Astro.url.pathname === "/index.html" ? "/" : Astro.url.pathname.replace(/\.html$/, "");
const pageUrl = new URL(Astro.locals.publishedCanonical || userCanonical || builtPath, Astro.site ?? Astro.url);
const pagePath = pageUrl.pathname;
const pathKey = pagePath.replace(/\/$/, "") || "/";
const titleOverrides: Record<string, string> = seo.titles;
const descriptionOverrides: Record<string, string> = seo.descriptions;
const pageSettings=await pageSearch(pathKey);
const entrySettings=Astro.locals.publishedSearch || await contentSearch(pathKey);
const noIndex=!!Astro.locals.publishedCanonical || !!entrySettings?.hide_from_search || !!pageSettings?.no_index;
const resolvedTitle = entrySettings?.search_title || pageSettings?.title || titleOverrides[pathKey] || title || siteSettings['site:title'] || defaultTitle;
const rawDescription = entrySettings?.search_description || pageSettings?.description || descriptionOverrides[pathKey] || description || siteSettings['site:tagline'] || defaultDescription;
const resolvedDescription = rawDescription.length > 160
  ? rawDescription.slice(0, 157).replace(/\s+\S*$/, "") + "…"
  : rawDescription;
const cleanPath =
  pagePath.endsWith("/") && pagePath.length > 1
    ? pagePath.slice(0, -1)
    : pagePath;
const requestedCanonical = Astro.locals.publishedCanonical || entrySettings?.preferred_url || pageSettings?.canonical || userCanonical;
const canonical = requestedCanonical
  ? new URL(requestedCanonical, Astro.site ?? Astro.url).toString()
  : Astro.site
    ? new URL(cleanPath, Astro.site).toString()
    : Astro.url.href;
const cmsImage=entrySettings?.social_image || pageSettings?.image;
const selectedImage=cmsImage?.id ? websiteImage(cmsImage,fallbackSocialImage) : undefined;
const resolvedImage = selectedImage ? {url:selectedImage.image.src,alt:selectedImage.alt || resolvedTitle,width:selectedImage.image.width,height:selectedImage.image.height,type:`image/${selectedImage.image.format === 'jpg' ? 'jpeg' : selectedImage.image.format}`} :
  typeof image === "string"
    ? { url: image, alt: resolvedTitle, width: 1200, height: 630, type: "image/jpeg" }
    : image ?? {
        url: "/og-image.jpg",
        alt: resolvedTitle,
        width: 1200,
        height: 630,
        type: "image/jpeg",
      };
const toAbsoluteUrl = (value?: string) => {
  if (!value) return undefined;
  if (/^https?:\/\//.test(value)) return value;
  return Astro.site ? new URL(value, Astro.site).toString() : value;
};
const absoluteImage = toAbsoluteUrl(resolvedImage.url);
const absoluteVideo = toAbsoluteUrl(video);
---

<title>{resolvedTitle}</title>
<meta name="robots" content={noIndex ? "noindex, nofollow" : "index, follow"} />
<meta name="googlebot" content={noIndex ? "noindex, nofollow" : "index, follow"} />
<meta name="description" content={resolvedDescription} />
<link rel="canonical" href={canonical} />

<meta property="og:site_name" content={siteSettings["site:title"] || defaultTitle} />
<meta property="og:type" content={ogType} />
<meta property="og:title" content={resolvedTitle} />
<meta property="og:description" content={resolvedDescription} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content="en_AU" />
{absoluteImage && <meta property="og:image" content={absoluteImage} />}
{resolvedImage.alt && <meta property="og:image:alt" content={resolvedImage.alt} />}
{resolvedImage.width && <meta property="og:image:width" content={String(resolvedImage.width)} />}
{resolvedImage.height && <meta property="og:image:height" content={String(resolvedImage.height)} />}
{resolvedImage.type && <meta property="og:image:type" content={resolvedImage.type} />}
{absoluteVideo && <meta property="og:video" content={absoluteVideo} />}
{absoluteVideo && <meta property="og:video:secure_url" content={absoluteVideo} />}
{absoluteVideo && <meta property="og:video:type" content="video/mp4" />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={resolvedTitle} />
<meta name="twitter:description" content={resolvedDescription} />
{absoluteImage && <meta name="twitter:image" content={absoluteImage} />}

<link rel="alternate" type="application/rss+xml" title="Married by Jake — Blog" href="/rss.xml" />
<link rel="alternate" type="application/json" title="Married by Jake — Search index" href="/search.json" />
<link rel="author" type="text/plain" href="/humans.txt" />
