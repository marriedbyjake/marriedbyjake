---
import Seo from "@/components/fundations/head/Seo.astro";
import Meta from "@/components/fundations/head/Meta.astro";
import Fonts from "@/components/fundations/head/Fonts.astro";
import Favicons from "@/components/fundations/head/Favicons.astro";
import { getCollection } from "astro:content";
const { title, description, canonical, image, video, ogType } = Astro.props as {
  title?: string;
  description?: string;
  canonical?: string;
  image?:
    | string
    | { url: string; alt?: string; width?: number; height?: number; type?: string };
  video?: string;
  ogType?: string;
};

// Aggregate rating computed from real testimonial data at build time
const allTestimonials = await getCollection("weddingtestimonials");
const ratedTestimonials = allTestimonials.filter(
  (t) => typeof t.data.rating === "number",
);
const reviewCount = ratedTestimonials.length;
const ratingSum = ratedTestimonials.reduce((sum, t) => sum + t.data.rating, 0);
const ratingValue = reviewCount > 0 ? (ratingSum / reviewCount).toFixed(1) : "5.0";
---
<Meta />
<Seo title={title} description={description} canonical={canonical} image={image} video={video} ogType={ogType} />
<Fonts />
<Favicons />
<script
