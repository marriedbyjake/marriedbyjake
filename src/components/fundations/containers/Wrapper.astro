---
interface Props {
  variant?: "standard" | "paddingLess" | "prose"; // Define any variants you need
  class?: string; // Optional prop for additional classes
}
const { variant = "standard", class: extraClass = "" } = Astro.props;
// Map each variant to its specific classes
const variantClasses = {
  // All purpose wrapper
  standard:
    " max-w-screen mx-auto px-8 md:px-12 lg:px-24 w-full 2xl:max-w-[120rem]",
  paddingLess: "max-w-screen mx-auto w-full 2xl:max-w-[120rem]",
  // Wrapper for prose blocks
  prose:
    "prose prose-lg text-base-600 prose-p:leading-relaxed prose-p:my-6 prose-li:leading-relaxed prose-li:my-2 prose-ul:my-6 prose-ol:my-6 prose-headings:font-display prose-headings:font-medium prose-headings:text-base-800 prose-headings:tracking-tight prose-h2:mt-14 prose-h2:mb-5 prose-h3:mt-10 prose-h3:mb-3 prose-blockquote:border-l-accent prose-blockquote:text-base-600 prose-blockquote:font-normal prose-blockquote:not-italic prose-a:text-accent-700 prose-a:font-medium prose-a:underline prose-a:decoration-accent-300 prose-a:decoration-1 prose-a:underline-offset-4 prose-a:transition-colors prose-a:duration-200 prose-a:hover:text-accent-800 prose-a:hover:decoration-accent-600 prose-strong:text-base-800 prose-strong:font-semibold prose-pre:border prose-pre:border-base-300 prose-pre:rounded-xl prose-pre:scrollbar-hide prose-li:marker:text-accent-600 prose-ul:[list-style-type:'—'] max-w-none w-full",
};
// Combine the classes for the specified variant with any extra classes
const classes = `${variantClasses[variant]} ${extraClass}`.trim();
---

<div class={classes}>
  <slot />
</div>
