---
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import { heroVideo } from "@/data/hero-video";
---

<Wrapper variant="paddingLess">
  <div class="relative overflow-hidden" data-hero-media>
    <picture>
      <source
        media="(max-width: 767px)"
        srcset={heroVideo.mobile.poster}
        width={heroVideo.mobile.width}
        height={heroVideo.mobile.height}
      />
      <img
        src={heroVideo.desktop.poster}
        alt=""
        aria-hidden="true"
        width={heroVideo.desktop.width}
        height={heroVideo.desktop.height}
        fetchpriority="high"
        decoding="async"
        data-hero-poster
        class="w-full h-[60dvh] lg:h-[72dvh] object-cover object-center bg-base-50"
      />
    </picture>
    <video
      muted
      loop
      playsinline
      preload="none"
      aria-hidden="true"
      disablepictureinpicture
      disableRemotePlayback
      data-hero-video
      data-mobile-src={heroVideo.mobile.src}
      data-desktop-src={heroVideo.desktop.src}
      class="absolute inset-0 pointer-events-none object-cover object-center w-full h-[60dvh] lg:h-[72dvh] bg-base-50 opacity-0 transition-opacity duration-300 motion-reduce:transition-none"
    ></video>
    <div
      aria-hidden="true"
      class="absolute inset-0 pointer-events-none bg-accent-950/40"
    >
    </div>
  </div>
</Wrapper>

<script>
  import "@/scripts/hero-video";
</script>
