---
import {websiteSection,websiteImage} from '@/lib/website';
import WebsiteText from '@/components/content/WebsiteText.astro';
const section = await websiteSection('approach');

import { Image } from "astro:assets";
import customer from "@/images/jake-snow.jpg";

import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

const approachSteps = section.steps.map((step:any)=>({...step,bullets:step.bullets.split('\n').filter(Boolean)}));
---

<section>
  <Wrapper variant="paddingLess" class="py-24">
    <div class="grid grid-cols-1 lg:grid-cols-2">
      <div>
        <div class="relative w-full lg:sticky lg:top-16 lg:h-screen">
          <Image
            src={websiteImage(section.image,customer).image}
            width={1440}
            height={900}
            alt={websiteImage(section.image,customer).alt || "Married by Jake — ceremony in full swing"}
            class="object-cover object-center w-full h-full bg-base-50"
            loading="lazy"
            decoding="async"
          />
          <div
            class="lg:absolute lg:inset-0 size-full bg-accent-900 lg:bg-accent-900/90 flex flex-col items-start justify-start px-8 md:px-12 lg:px-24 z-10 py-24"
          >
            <div class="w-full">
              <Text
                tag="p"
                variant="textXS"
                class="text-secondary-400 tracking-wide uppercase"
              >{section.eyebrow}</Text>
              <Text
                tag="h2"
                variant="displayLG"
                class="text-white font-display text-balance mt-12"
              >{section.heading}</Text>
              <Text tag="p" variant="textSM" class="text-base-300 mt-2"><WebsiteText inline value={section.body} /></Text>
              <div
                class="mt-12 grid grid-cols-1 overflow-hidden lg:grid-cols-2 bg-white/5 backdrop-blur-sm"
              >
                <Image
                  src={websiteImage(section.image,customer).image}
                  width={500}
                  height={500}
                  loading="lazy"
                  decoding="async"
                  alt={websiteImage(section.image,customer).alt || "Real couple sharing a moment during their ceremony"}
                  class="object-cover h-60 size-full object-top hidden lg:block"
                />
                <figure class="p-4 flex flex-col h-full justify-between">
                  <blockquote>
                    <Text tag="p" variant="textSM" class="text-base-300 italic">{`“${section.quote}”`}</Text>
                  </blockquote>
                  <figcaption class="mt-3 flex items-center gap-3">
                    <Text
                      tag="p"
                      variant="textXS"
                      class="text-secondary-300 font-medium"
                    ><a href={section.quote_url}>{section.quote_author}</a></Text>
                  </figcaption>
                </figure>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="p-8 lg:p-20 bg-base-50">
        <ol class="flex flex-col gap-8">
          {
            approachSteps.map((step:any, idx:number) => (
              <li class="bg-white p-8 flex flex-col items-start sticky top-8 lg:top-20">
                <Text
                  tag="p"
                  variant="displayXL"
                  class="text-accent-800 font-display italic font-medium"
                >
                  {idx + 1}
                </Text>
                <Text
                  tag="h3"
                  variant="displaySM"
                  class="text-base-800 font-display mt-12"
                >
                  {step.title}
                </Text>
                <Text
                  tag="p"
                  variant="textSM"
                  class="text-base-600 text-balance"
                >
                  {step.description}
                </Text>
                <ul class="list-disc space-y-1 list-inside mt-4 pt-4 border-t border-base-100">
                  {step.bullets.map((bullet:string) => (
                    <li class="text-base-600 text-sm">{bullet}</li>
                  ))}
                </ul>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </Wrapper>
</section>
