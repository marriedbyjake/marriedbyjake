---
import {websiteSection} from '@/lib/website';
import WebsiteText from '@/components/content/WebsiteText.astro';
const section = await websiteSection('values');

// Foundations
import Text from "@/components/fundations/elements/Text.astro";

import Wrapper from "@/components/fundations/containers/Wrapper.astro";

// Icons
import Action from "@/components/fundations/icons/Action.astro";
import Integrity from "@/components/fundations/icons/Integrity.astro";
import Partnership from "@/components/fundations/icons/Partnership.astro";

const philosophyCards = section.cards.map((card:any)=>({...card,icon:({integrity:Integrity,action:Action,partnership:Partnership} as any)[card.icon]}));
---

<section>
  <Wrapper variant="standard" class="py-24">
    <div class="grid grid-cols-1 lg:grid-cols-4 items-start gap-y-8">
      <Text
        tag="p"
        variant="textXS"
        class="text-secondary-800 tracking-wide uppercase"
      >{section.eyebrow}</Text>

      <div class="lg:col-span-3">
        <Text
          tag="h2"
          variant="displayLG"
          class="text-accent-800 font-display text-balance"
        >{section.heading}</Text>

        <Text tag="p" variant="textLG" class="text-base-600 mt-4"><WebsiteText inline value={section.body} /></Text>

        <Text tag="p" variant="textBase" class="text-base-700 mt-2"><WebsiteText inline value={section.secondary_body} /></Text>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 mt-12 lg:mt-24 gap-8">
      {
        philosophyCards.map((card:any) => (
          <div class="bg-base-50 p-8 flex flex-col">
            {card.icon && <card.icon class="size-8 text-secondary-400" />}

            <Text
              tag="h3"
              variant="displaySM"
              class="text-accent-800 font-display mt-12"
            >
              {card.title}
            </Text>

            <Text
              tag="p"
              variant="textSM"
              class="text-base-600 font-medium mt-2"
            >
              {card.description}
            </Text>
          </div>
        ))
      }
    </div>
  </Wrapper>
</section>
