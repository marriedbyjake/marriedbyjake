---
import { Image } from "astro:assets";
import LogoImage from "@/images/logo.png";
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import {websiteSection,websiteMenu,websiteImage,siteSettings} from '@/lib/website';
import WebsiteText from '@/components/content/WebsiteText.astro';
const section=await websiteSection('footer');
const currentYear=new Date().getFullYear();
const linkSections=[
 {title:section.quick_links_label,items:websiteMenu('footer-navigation')},
 {title:section.social_links_label,items:websiteMenu('social-links')},
 {title:section.found_on_label,items:websiteMenu('found-on-links')},
];
const logo=websiteImage(section.logo || (siteSettings['site:logo']?{id:siteSettings['site:logo'].mediaId,provider:'local'}:null),LogoImage);
---

<footer class="bg-base-50">
  <Wrapper variant="standard" class="py-16">
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-8 mb-8">
      <div class="col-span-full md:col-span-1 flex justify-center md:justify-start">
        <Image
          src={logo.image}
          alt={logo.alt || section.logo_alt}
          width={1600}
          height={755}
          class="w-full max-w-80 h-auto object-contain"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="col-span-full md:col-span-1">
        <Text
          tag="p"
          variant="textXS"
          class="text-base-600 mt-5 leading-relaxed"
        >
          <WebsiteText inline value={section.description} />
        </Text>
        
      </div>
      {
        linkSections.map((section) => (
          <div>
            <Text tag="p" variant="textXS" class="text-secondary-700">
              {section.title}
            </Text>
            <ul class="flex flex-col gap-1 mt-4">
              {section.items.map((item) => (
                <li>
                  <a
                    href={item.href} target={item.target} rel={item.target === "_blank" ? "noopener noreferrer" : undefined}
                    class="text-base-600 hover:text-accent-800 transition-colors text-xs"
                  >
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
      <div class="col-span-full flex justify-center pt-4">
        <a href={section.badge_url} target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full text-white text-xs font-semibold no-underline transition-opacity hover:opacity-85" style="background:#460479;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/></svg>
          {section.badge_label}
        </a>
      </div>
    </div>
    <div class="border-t border-base-100 pt-8">
      <div
        class="flex flex-col md:flex-row justify-between lg:items-center gap-4"
      >
        <div class="text-base-600 text-sm">
          <Text tag="p" variant="textXS">
            © {currentYear}{" "}{section.copyright_name}.{" "}<WebsiteText inline value={section.copyright_suffix} />
          </Text>
        </div>
        <div class="flex flex-col md:flex-row gap-4 text-base-600 text-xs">
          {websiteMenu('legal-links').map(item=><a href={item.href} target={item.target} rel={item.target === '_blank' ? 'noopener noreferrer' : undefined} class="hover:text-accent-800 transition-colors">{item.label}</a>)}
        </div>
      </div>
      <div class="mt-6 pt-6 border-t border-base-100">
        <Text tag="p" variant="textXS" class="text-base-600 leading-relaxed">
<WebsiteText inline value={section.legal_notice} />
        </Text>
      </div>
    </div>
  </Wrapper>
</footer>
