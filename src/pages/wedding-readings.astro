---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import raw from "../../readings.txt?raw";

const lines = raw.split(/\r?\n/);
const isSep = (s: string) => /^\*{5,}\s*$/.test(s.trim());
const readings: Array<{ title: string; body: string }> = [];
let buffer: string[] = [];
const pushBlock = (buf: string[]) => {
  const idx = buf.findIndex((l) => l.trim().length > 0);
  if (idx === -1) return;
  const title = buf[idx].trim();
  const body = buf.slice(idx + 1).join("\n").trim();
  if (title) readings.push({ title, body });
};
for (const l of lines) {
  if (isSep(l)) {
    if (buffer.length) pushBlock(buffer), (buffer = []);
  } else {
    buffer.push(l);
  }
}
if (buffer.length) pushBlock(buffer);
---

<BaseLayout title="Wedding Readings" description="A beautifully typeset collection of wedding readings and poems — timeless scripture, blessings and modern pieces — curated for ceremonies and easy to browse, share and choose from." canonical="/wedding-readings">
  <section>
    <Wrapper variant="standard" class="pb-24 pt-48">
      <div class="max-width">
        <Text tag="h1" variant="displayXL" class="text-accent-800 font-display text-balance  text-center">Wedding Readings</Text>
        <Text tag="p" variant="textSM" class="text-base-600 mt-3 text-center">A calm, elegant collection of readings and poems for your ceremony. Browse classics and modern pieces, presented like a poetry book with clear titles and gentle spacing.</Text>
      </div>

      <div class="mt-12 lg:mt-20 space-y-12 lg:space-y-16">
        {readings.map((r) => (
          <article class="relative bg-white border border-base-100 rounded-lg p-8 lg:p-12 shadow-sm">
            <Text tag="h2" variant="displaySM" class="mb-3 text-accent-800 font-display text-center">{r.title}</Text>
            <p class="mt-1 text-base-700 leading-loose tracking-normal lg:text-lg first-letter:text-accent-700 first-letter:font-display first-letter:text-4xl first-letter:float-left first-letter:mr-1 first-letter:leading-none">
              {r.body}
            </p>
          </article>
        ))}
      </div>
    </Wrapper>
  </section>
</BaseLayout>
