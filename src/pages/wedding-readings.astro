---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import { getCollection, render } from "astro:content";

const readingsCollection = await getCollection("readings");

// Strip markdown syntax down to a flat lowercased string we can match against.
const toSearchText = (s: string) =>
  s
    .replace(/```[\s\S]*?```/g, " ")
    .replace(/!\[[^\]]*\]\([^)]*\)/g, " ")
    .replace(/\[([^\]]+)\]\([^)]*\)/g, "$1")
    .replace(/[#>*_`~]/g, " ")
    .replace(/\s+/g, " ")
    .trim()
    .toLowerCase();

const readings = await Promise.all(
  readingsCollection
    .sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999))
    .map(async (r) => {
      const { Content } = await render(r);
      const searchText = toSearchText(
        [r.data.title, r.data.author ?? "", r.body ?? ""].join(" "),
      );
      return { id: r.id, data: r.data, Content, searchText };
    })
);
---

<BaseLayout title="Wedding Readings" description="A beautifully typeset collection of wedding readings and poems — timeless scripture, blessings and modern pieces — curated for ceremonies and easy to browse, share and choose from." canonical="/wedding-readings">
  <section>
    <Wrapper variant="standard" class="pb-24 pt-48">
      <div class="max-w-3xl mx-auto">
        <Text tag="h1" variant="displayXL" class="text-accent-800 font-display text-balance text-center">Wedding Readings</Text>
        <Text tag="p" variant="textSM" class="text-base-600 mt-3 text-center">A calm, elegant collection of readings and poems for your ceremony. Browse classics and modern pieces.</Text>

        <div class="mt-10 lg:mt-12">
          <label for="readings-search" class="sr-only">Search wedding readings</label>
          <div class="relative">
            <input
              id="readings-search"
              type="search"
              autocomplete="off"
              placeholder="Search readings by title, author or a line…"
              class="w-full rounded-full border border-base-200 bg-white px-5 py-3 pr-12 text-base text-base-800 placeholder:text-base-500 shadow-sm focus:border-accent-700 focus:outline-none focus:ring-2 focus:ring-accent-700/20"
            />
            <button
              type="button"
              id="readings-search-clear"
              aria-label="Clear search"
              class="absolute right-2 top-1/2 hidden -translate-y-1/2 rounded-full p-2 text-base-500 hover:bg-base-100 hover:text-base-800"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
          </div>
          <p id="readings-count" class="mt-2 text-center text-xs text-base-500" aria-live="polite">
            Showing all {readings.length} readings
          </p>
        </div>
      </div>

      <div id="readings-list" class="mt-12 lg:mt-16 space-y-12 lg:space-y-16 max-w-3xl mx-auto">
        {readings.map((r) => (
          <article
            class="reading-card relative bg-white border border-base-100 rounded-lg p-8 lg:p-12 shadow-sm"
            data-search={r.searchText}
          >
            <Text tag="h2" variant="displaySM" class="mb-3 text-accent-800 font-display text-center">{r.data.title}</Text>
            {r.data.author && (
              <Text tag="p" variant="textXS" class="text-base-600 mb-6 text-center italic">{r.data.author}</Text>
            )}
            <div class="reading-body text-base-700 leading-loose tracking-normal lg:text-lg">
              <r.Content />
            </div>
          </article>
        ))}
        <p id="readings-empty" class="hidden text-center text-base-500 py-12">
          No readings match that search. Try a different word or clear the filter.
        </p>
      </div>
    </Wrapper>
  </section>
</BaseLayout>

<script is:inline>
  (() => {
    const input = document.getElementById("readings-search");
    const clear = document.getElementById("readings-search-clear");
    const count = document.getElementById("readings-count");
    const empty = document.getElementById("readings-empty");
    const list = document.getElementById("readings-list");
    if (!input || !list || !count) return;

    const cards = Array.from(list.querySelectorAll(".reading-card"));
    const total = cards.length;

    const applyFilter = (raw) => {
      const q = (raw || "").trim().toLowerCase();
      if (clear) clear.classList.toggle("hidden", q.length === 0);

      if (q.length === 0) {
        for (const card of cards) card.style.display = "";
        count.textContent = `Showing all ${total} readings`;
        if (empty) empty.classList.add("hidden");
        return;
      }

      let visible = 0;
      for (const card of cards) {
        const haystack = card.getAttribute("data-search") || "";
        const match = haystack.includes(q);
        card.style.display = match ? "" : "none";
        if (match) visible++;
      }

      count.textContent =
        visible === 0
          ? "No matches"
          : visible === 1
            ? "Showing 1 reading"
            : `Showing ${visible} of ${total} readings`;

      if (empty) empty.classList.toggle("hidden", visible !== 0);
    };

    input.addEventListener("input", (e) => applyFilter(e.target.value));
    if (clear) {
      clear.addEventListener("click", () => {
        input.value = "";
        applyFilter("");
        input.focus();
      });
    }
  })();
</script>

<style>
  .reading-body :global(p) {
    margin-bottom: 1rem;
  }
  .reading-body :global(p:last-child) {
    margin-bottom: 0;
  }
  .reading-body :global(p:first-child::first-letter) {
    color: var(--color-accent-700, #92400e);
    font-family: var(--font-display, serif);
    font-size: 2.25rem;
    float: left;
    margin-right: 0.25rem;
    line-height: 1;
  }
</style>
