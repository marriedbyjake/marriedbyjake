---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import Button from "@/components/fundations/elements/Button.astro";
import { Image } from "astro:assets";
import pool from "@/images/pool.jpg";
const ogImage = {
  url: pool.src,
  alt: "Pool image",
  width: pool.width,
  height: pool.height,
  type: "image/webp",
};
---

<BaseLayout navTransparent={true} title="Thanks for Your Enquiry" description="Thank you so much — someone will respond via email ASAP." canonical="/thank-you" image={ogImage}>
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <section>
    <Wrapper variant="paddingLess">
      <script is:inline>
        window.gtag?.("event", "conversion", {
          send_to: "AW-939233637/P9jQCLG9mmsQ5aLuvwM",
        });
        window.dispatchEvent(new Event("mbj:load-tracking"));
      </script>
      <noscript>
      <div style="display:inline;">
      <img height="1" width="1" style="border-style:none;" alt="" src="//www.googleadservices.com/pagead/conversion/939233637/?label=P9jQCLG9mmsQ5aLuvwM&amp;guid=ON&amp;script=0"/>
      </div>
      </noscript>
      <div class="relative overflow-hidden">
        <Image
          src={pool}
          alt="Pool image"
          width={1440}
          height={900}
          loading="eager"
          decoding="async"
          class="object-cover object-center w-full h-[50dvh] lg:h-[72dvh] bg-base-50"
        />
        <div aria-hidden="true" class="absolute inset-0 pointer-events-none bg-accent-950/40"></div>
      </div>
    </Wrapper>
    <Wrapper variant="standard" class="pb-12 pt-12 lg:pt-24">
      <div class="max-w-2xl">
        <Text tag="h1" variant="displayXL" class="text-accent-800 font-display text-balance">
          Thanks for Your Enquiry
        </Text>
        <Text tag="p" variant="textSM" class="text-base-600 leading-relaxed mt-2">
          Thankyou so much! Hope I’m able to help with your plans!
        </Text>
        <Text tag="p" variant="textSM" class="text-base-600 leading-relaxed mt-2">
          Someone will respond via email ASAP… keep an eye on your spam folder :)
        </Text>
        <Text tag="p" variant="textSM" class="text-base-600 leading-relaxed mt-6">
          In the meantime, if you haven't already, you can check out the following links:
        </Text>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mt-8">
        <Button isLink={true} href="/blog" variant="muted" size="sm" class="w-full lg:w-fit">Watch some wedding tips!</Button>
        <Button isLink={true} href="/faq" variant="muted" size="sm" class="w-full lg:w-fit">Check out the pricing and inclusions list</Button>
        <Button isLink={true} href="/weddingtestimonials" variant="muted" size="sm" class="w-full lg:w-fit">Hear from Jake’s family of clients</Button>
        <Button isLink={true} href="/faq" variant="muted" size="sm" class="w-full lg:w-fit">Find out about celebrant pricing</Button>
        <Button isLink={true} href="/master-of-ceremonies" variant="muted" size="sm" class="w-full lg:w-fit">Read more about having Jake MC your reception</Button>
      </div>
    </Wrapper>
  </section>
</BaseLayout>
