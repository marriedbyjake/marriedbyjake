---
import {websiteSection} from '@/lib/website';
import WebsiteText from '@/components/content/WebsiteText.astro';
const section = await websiteSection('faq');

// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Icons
import Plus from "@/components/fundations/icons/Plus.astro";
const faqs = section.questions;
const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  inLanguage: "en-AU",
  speakable: {
    "@type": "SpeakableSpecification",
    cssSelector: [".faq-question", ".faq-answer"],
  },
  mainEntity: faqs.map((f:any) => ({
    "@type": "Question",
    name: f.question,
    acceptedAnswer: { "@type": "Answer", text: f.answer },
  })),
};
---

<BaseLayout
  title="Frequently Asked Questions Married By Jake"
  description="Answers about booking Jake Smith, legal marriage documents, the NOIM, vows, rehearsals, travel, elopements and wedding timelines."
>
  <section>
    <Wrapper variant="standard" class="pb-12 pt-48">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-y-8 gap-x-12">
        <div>
          <Text
            tag="h1"
            variant="displayMD"
            class="text-accent-800 font-display text-balance"
          >{section.heading}</Text>
          <Text tag="p" variant="textSM" class="text-base-700 mt-2"><WebsiteText inline value={section.body} /></Text>
          <Button
            size="xs"
            variant="muted"
            isLink={true}
            href={section.primary_url}
            class="w-full lg:w-fit mt-8"
          >{section.primary_label}</Button>
        </div>

        <div class="lg:col-span-2 divide-y divide-base-100 space-y-4">
          {
            faqs.map((faq:any) => (
              <details class="transition-colors pb-4 group">
                <summary class=" text-lg cursor-pointer text-accent-800 flex justify-between items-center group-open:text-secondary-500">
                  <span class="faq-question">{faq.question}</span>
                  <Plus
                    slot="icon"
                    size="sm"
                    class="text-base-700 transition-transform group-open:rotate-180 duration-300"
                  />
                </summary>
                <div class="mt-4 text-base-700 leading-relaxed faq-answer">
                  <Text tag="p" variant="textBase">
                    {faq.answer}
                  </Text>
                </div>
              </details>
            ))
          }
        </div>
      </div>
    </Wrapper>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd, null, 2).replace(/</g, "\\u003c")} />
  </section>
</BaseLayout>
