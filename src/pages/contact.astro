---
import PublishedImage from "@/components/content/PublishedImage.astro";
import {websiteSection} from '@/lib/website';
import WebsiteText from '@/components/content/WebsiteText.astro';
const section = await websiteSection('contact-intro');
const form=await websiteSection('contact-form');

// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
---

<BaseLayout
  title="Contact Married By Jake - Wedding Celebrant"
  description="Ask Jake Smith about availability, ceremony plans and a personal quote for your wedding in Brisbane, across Australia or overseas."
>
  <section>
    <Wrapper variant="standard" class="pb-12 pt-48">
      <div class="overflow-hidden grid grid-cols-1 lg:grid-cols-2">
        <div class="p-8 h-full flex flex-col justify-start bg-base-50">
          <div>
            {section.image?.id && <PublishedImage node={{_type:'image',asset:{_ref:section.image.id},alt:section.image.alt||section.heading}}/>}
<Text
              tag="h1"
              variant="displayMD"
              class="text-accent-800 font-display text-balance lg:col-span-2"
            >{section.eyebrow && <span class="block text-sm font-sans mb-2">{section.eyebrow}</span>}{section.heading}</Text>
            <!--<div class="space-y-1 mt-8">
              {
                contactInfo.map((info) => (
                  <div class="flex items-start space-x-3">
                    <Text
                      tag="p"
                      variant="textSM"
                      class="font-medium text-accent-800"
                    >
                      {info.label}
                    </Text>
                    {info.href !== "#" ? (
                      <a
                        href={info.href}
                        class="text-secondary-600 hover:text-accent-800 transition-colors"
                      >
                        <Text tag="p" variant="textSM">
                          {info.value}
                        </Text>
                      </a>
                    ) : (
                      <Text tag="p" variant="textSM" class="text-base-600">
                        {info.value
                          .split("\n")
                          .map((line) => line.trim())
                          .join(", ")}
                      </Text>
                    )}
                  </div>
                ))
              }
            </div> -->
            <div class="text-base-600 mt-4"><WebsiteText value={section.body} /></div>
          </div>
          
        </div>
        <iframe src={form.url} title={form.title} data-embed="true" style={`width:100%; border:0; height:${form.height}px;`} height={form.height} allowfullscreen></iframe>
      </div>
    </Wrapper>
  </section>
</BaseLayout>
