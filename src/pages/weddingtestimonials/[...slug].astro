---
import "@/styles/prose.css";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import { Image } from "astro:assets";
import Cta from "@/components/global/CtaReviews.astro";
import { getCollection, getEntry } from "@/lib/cms";
import { PortableText } from "emdash/ui";
const page = await getEntry("weddingtestimonials", Astro.params.slug || "");
if (!page) return new Response("Not found", { status: 404 });
const fm = page.data;
const GOOGLE_MAPS_API_KEY = import.meta.env.PUBLIC_GOOGLE_MAPS_API_KEY || "";
const mapQuery = [fm.venue, fm.location].filter(Boolean).join(" ");
const mapEmbedSrc = GOOGLE_MAPS_API_KEY
  ? `https://www.google.com/maps/embed/v1/place?key=${GOOGLE_MAPS_API_KEY}&q=${encodeURIComponent(mapQuery)}&zoom=14`
  : `https://www.google.com/maps?q=${encodeURIComponent(mapQuery)}&output=embed&z=14`;
const reviewMarkdown = (page.body || "").split("## Wedding team")[0];
const bodyText = reviewMarkdown
  .replace(/^> ?/gm, "")
  .replace(/\[([^\]]+)\]\([^)]+\)/g, "$1")
  .replace(/\s+/g, " ").trim();
const description = `Read ${fm.coupleName}'s wedding review of Jake Smith, marriage celebrant${fm.venue ? ` at ${fm.venue}` : ""}. Explore personal ceremonies and wedding planning ideas.`;
const headingTitle = fm.venue
  ? `${fm.coupleName}'s ${fm.venue} wedding review`
  : `${fm.coupleName}'s wedding review`;
const seoTitle = `${fm.coupleName} | Jake Smith Celebrant Review`;
const locationPages = [
  { slug: "brisbane", name: "Brisbane", pattern: /brisbane|new farm|st lucia|indooroopilly|victoria park|bundaleer|hillstone|calile|lightspace/i },
  { slug: "gold-coast", name: "Gold Coast", pattern: /gold coast|nerang|burleigh|kirra|currumbin|tamborine|coolibah|sanctuary cove|tallebudgera|cowbell/i },
  { slug: "sunshine-coast", name: "Sunshine Coast", pattern: /sunshine coast|noosa|maleny|montville|yandina|caloundra|mooloolaba|tiffany/i },
  { slug: "byron-bay", name: "Byron Bay", pattern: /byron|bangalow|ballina|ewingsdale|fig tree restaurant/i },
  { slug: "sydney", name: "Sydney", pattern: /sydney|denham court|mosman|manly|palm beach|watsons bay|centennial park/i },
];
const localPage = locationPages.find(({ pattern }) => pattern.test([fm.venue, fm.location].filter(Boolean).join(" ")));
const planningLinks = [
  { href: "/wedding-celebrant", label: "Personal wedding ceremonies" },
  ...( /christian|pastor|faith|god|prayer/i.test(bodyText) ? [{ href: "/christian-wedding-celebrant", label: "Christian wedding ceremonies" }] : []),
  ...( /\bMC\b|reception|master of ceremonies/i.test(bodyText) ? [{ href: "/master-of-ceremonies", label: "Jake as your reception MC" }] : []),
  { href: "/wedding-readings", label: "Readings for your ceremony" },
  { href: "/serviceandprice", label: "Wedding services and pricing" },
  { href: "/faq", label: "Wedding planning questions" },
];
const formatDate = (d?: Date) =>
  d
    ? new Date(d).toLocaleDateString("en-AU", {
        year: "numeric",
        month: "long",
        day: "numeric",
      })
    : null;
const ratingToWord = (r: number) => {
  const words = ["zero", "one", "two", "three", "four", "five"];
  const i = Math.max(0, Math.min(5, Math.round(r)));
  return words[i] ?? String(r);
};
const buildAlt = (
  name?: string,
  venue?: string | null,
  location?: string | null,
  rating?: number
) => {
  const place = [venue, location].filter(Boolean).join(", ");
  const ratingWord = typeof rating === "number" ? ratingToWord(rating) : null;
  let text = "Jake Smith was the marriage celebrant";
  if (name) text += ` for ${name}`;
  if (place) text += ` at ${place}`;
  if (ratingWord) {
    text += `, and they gave him a ${ratingWord} star rating for his wedding celebrant services.`;
  } else {
    text += ".";
  }
  return text;
};
const siteOrigin = Astro.site ? Astro.site.origin : "https://marriedbyjake.com";
const canonicalUrl = `${siteOrigin}/weddingtestimonials/${page.id}`;
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Review",
      "@id": `${canonicalUrl}#review`,
      itemReviewed: { "@id": "https://marriedbyjake.com/#business" },
      author: { "@type": "Person", name: fm.coupleName },
      reviewRating: {
        "@type": "Rating",
        ratingValue: fm.rating,
        bestRating: 5,
        worstRating: 1,
      },
      reviewBody: bodyText,
      ...(fm.pubDate ? { datePublished: new Date(fm.pubDate).toISOString() } : {}),
      inLanguage: "en-AU",
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${siteOrigin}` },
        {
          "@type": "ListItem",
          position: 2,
          name: "Wedding Testimonials",
          item: `${siteOrigin}/weddingtestimonials`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: headingTitle,
          item: canonicalUrl,
        },
      ],
    },
  ],
};

// Get other testimonials for the "Read more" section
const allTestimonials = await getCollection("weddingtestimonials");
const otherTestimonials = allTestimonials
  .filter((t) => t.id !== page.id && t.data.image?.url)
  .sort((a, b) => {
    const dateDifference =
      new Date(b.data.pubDate || 0).getTime() -
      new Date(a.data.pubDate || 0).getTime();
    return dateDifference || a.id.localeCompare(b.id);
  })
  .slice(0, 6);
---
<BaseLayout title={seoTitle} description={description}>
  <section>
    <Wrapper variant="standard" class="pb-12 pt-48">
      <div class="grid lg:grid-cols-3 gap-12">
        <div>
          <div class="lg:sticky lg:top-48">
            <Text tag="h1" variant="displayMD" class="text-accent-800 font-display">
              {headingTitle}
            </Text>
          <Text tag="p" variant="textSM" class="text-base-700 mt-2">
            {fm.venue} · {fm.location}
          </Text>
          {fm.pubDate && (
            <Text tag="p" variant="textXS" class="text-base-600 mt-1">
              {formatDate(fm.pubDate)}
            </Text>
          )}
          <Text tag="p" variant="textXS" class="text-base-700 mt-1">{"★".repeat(fm.rating)}</Text>
          {(fm.venue || fm.location) && (
            <div class="mt-4 lg:h-96">
              <iframe
                src={mapEmbedSrc}
                title={`Map of ${[fm.venue, fm.location].filter(Boolean).join(", ")}`}
                loading="lazy"
                referrerpolicy="strict-origin-when-cross-origin"
                class="w-full h-60 lg:h-full border border-base-100 rounded-md"
              />
            </div>
          )}
          </div>
        </div>
        <div class="lg:col-span-2">
          {fm.image?.url && (
            <Image
              src={fm.image.url}
              alt={buildAlt(fm.coupleName, fm.venue, fm.location, fm.rating)}
              title={buildAlt(fm.coupleName, fm.venue, fm.location, fm.rating)}
              width={1200}
              widths={[480, 768, 1200]}
              sizes="(min-width: 1024px) 66vw, 100vw"
              loading="eager"
              fetchpriority="high"
              class="w-full h-auto"
            />
          )}
          <div class="mt-8 testimonial-body">
            <PortableText value={page.content} />
          </div>
          <aside class="mt-12 rounded-xl border border-base-200 bg-base-50 p-6" aria-label="Plan your wedding">
            <h2 class="font-display text-2xl text-accent-800">Plan a ceremony that feels like you</h2>
            {localPage && <p class="mt-3">Getting married in the area? Explore Jake's <a class="underline text-accent-700" href={`/${localPage.slug}`}>{localPage.name} wedding celebrant services</a>.</p>}
            <ul class="mt-4 flex flex-wrap gap-x-6 gap-y-3">
              {planningLinks.map(({ href, label }) => <li><a class="underline text-accent-700" href={href}>{label}</a></li>)}
            </ul>
            <h3 class="mt-6 font-medium text-accent-800">Wedding locations</h3>
            <ul class="mt-3 flex flex-wrap gap-x-6 gap-y-3">
              {locationPages.map(({ slug, name }) => <li><a class="underline text-accent-700" href={`/${slug}`}>{name}</a></li>)}
            </ul>
          </aside>
        </div>
      </div>
    </Wrapper>
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd, null, 2).replace(/</g, "\\u003c")}
    />
  </section>

  <Cta />

  {otherTestimonials.length > 0 && (
    <section class="bg-base-50 py-12 lg:py-24 border-t border-base-200">
      <Wrapper variant="standard">
        <Text tag="h2" variant="displaySM" class="text-accent-800 font-display mb-8">
          More Happy Couples
        </Text>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {otherTestimonials.map((t) => (
            <a href={`/weddingtestimonials/${t.id}`} class="group block">
              <div class="aspect-[4/3] overflow-hidden rounded-lg mb-4 bg-base-200">
                {t.data.image?.url && (
                  <Image
                    src={t.data.image.url}
                    alt={buildAlt(t.data.coupleName, t.data.venue, t.data.location, t.data.rating)}
                    title={buildAlt(t.data.coupleName, t.data.venue, t.data.location, t.data.rating)}
                    width={600}
                    height={450}
                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                    loading="lazy"
                    decoding="async"
                  />
                )}
              </div>
              <Text
                tag="h3"
                variant="textLG"
                class="text-accent-800 font-display group-hover:text-accent-600 transition-colors"
              >
                {t.data.coupleName}
              </Text>
              <Text tag="p" variant="textXS" class="text-base-600 mt-1">
                {[t.data.venue, t.data.location].filter(Boolean).join(" · ")}
              </Text>
            </a>
          ))}
        </div>
      </Wrapper>
    </section>
  )}
</BaseLayout>

<style>
  /* Testimonial body — standalone article-style typography.
     No Tailwind Typography prose inheritance — we control everything. */
  .testimonial-body {
    max-width: 42rem;
    font-family: var(--font-inter), system-ui, sans-serif;
    color: var(--color-base-700);
  }

  .testimonial-body :global(p) {
    font-size: 0.9375rem;
    line-height: 1.7;
    letter-spacing: -0.003em;
    color: var(--color-base-700);
    margin: 0 0 1.25rem 0;
    padding: 0;
    text-wrap: pretty;
    font-feature-settings: "liga" 1, "calt" 1, "ss01" 1;
  }
  .testimonial-body :global(p:last-child) {
    margin-bottom: 0;
  }
  @media (min-width: 1024px) {
    .testimonial-body :global(p) {
      font-size: 1rem;
      line-height: 1.75;
      margin-bottom: 1.5rem;
    }
  }

  .testimonial-body :global(a) {
    color: var(--color-accent-700);
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: var(--color-accent-500);
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    transition: color 200ms ease, text-decoration-color 200ms ease,
      text-decoration-thickness 200ms ease;
  }
  .testimonial-body :global(a:hover) {
    color: var(--color-accent-800);
    text-decoration-color: var(--color-accent-700);
    text-decoration-thickness: 2px;
  }

  .testimonial-body :global(em) {
    font-style: italic;
  }
  .testimonial-body :global(strong) {
    font-weight: 600;
    color: var(--color-base-800);
  }

  .testimonial-body :global(h2),
  .testimonial-body :global(h3) {
    font-family: var(--font-newsreader), Georgia, serif;
    color: var(--color-base-800);
    font-weight: 500;
    margin: 2rem 0 1rem 0;
  }
  .testimonial-body :global(h2) { font-size: 1.5rem; line-height: 1.3; }
  .testimonial-body :global(h3) { font-size: 1.25rem; line-height: 1.35; }

  .testimonial-body :global(ul),
  .testimonial-body :global(ol) {
    margin: 0 0 1.5rem 0;
    padding-left: 1.5rem;
  }
  .testimonial-body :global(li) {
    margin-bottom: 0.5rem;
    line-height: 1.7;
  }

  .testimonial-body :global(blockquote) {
    margin: 0;
    padding: clamp(1.5rem, 4vw, 3rem);
    border-left: 4px solid var(--color-accent-500);
    border-radius: 0 1rem 1rem 0;
    background: var(--color-base-50);
  }
  .testimonial-body :global(blockquote p) {
    font-family: var(--font-newsreader), Georgia, serif;
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    line-height: 1.65;
    color: var(--color-accent-800);
  }
  .testimonial-body :global(h2 + ul) {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: 0.75rem;
  }
  .testimonial-body :global(h2 + ul li) {
    padding: 1rem;
    margin: 0;
    border: 1px solid var(--color-base-200);
    border-radius: 0.5rem;
    font-size: 0.875rem;
  }
</style>
