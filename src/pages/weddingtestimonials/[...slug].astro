---
import { getCollection, getEntry } from "@/lib/cms";
import TestimonialPage from "@/components/content/TestimonialPage.astro";
export async function getStaticPaths() {
  return (await getCollection("weddingtestimonials")).map(entry => ({ params: { slug: entry.id } }));
}
const page = await getEntry("weddingtestimonials", Astro.params.slug!);
if (!page) throw new Error("Missing published testimonial");
---
<TestimonialPage page={page} />
