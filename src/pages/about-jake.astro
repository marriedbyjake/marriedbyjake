---
import {websiteSection,websiteImage} from '@/lib/website';
import WebsiteText from '@/components/content/WebsiteText.astro';
const section = await websiteSection('about');
const introductionVideo=await websiteSection('about-video');

import BaseLayout from "@/layouts/BaseLayout.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import { Image } from "astro:assets";
import JakeWide from "@/images/jake-wide-1.jpg";
import Text from "@/components/fundations/elements/Text.astro";
import LandingStats from "@/components/landing/LandingStats.astro";
import Cta from "@/components/global/Cta.astro";
import Video from "@/components/fundations/elements/Video.astro";

---
<BaseLayout navTransparent={true} title="About Married By Jake - Christian Wedding Celebrant" description="Explore Jake's wedding services, including ceremonies, elopements, destination weddings, and more." ogType="website">
  <section>
    <Wrapper variant="paddingLess">
      <Image
        src={websiteImage(section.image,JakeWide).image}
        alt={websiteImage(section.image,JakeWide).alt || "Wedding Celebrant Jake Smith"}
        width={2880}
        height={1440}
        class="object-cover object-center w-full h-[40dvh] lg:h-[120dvh] bg-base-50"
        quality="high"
      />
    </Wrapper>
    <Wrapper variant="standard" class="py-12">
    <Text tag="h1" variant="displayMD" class="font-display mt-12 lg:mt-24 mb-4"
        >{section.heading}</Text
      >
    <Text
        tag="p"
        variant="textMD"
        class="text-secondary-600 uppercase font-medium mb-4"
      >{section.eyebrow}</Text>
    {section.body.map((paragraph:any)=>(<Text
        tag="p"
        variant="textMD"
        class="text-md text-base-600 leading-relaxed border-accent-500 mb-4"
      ><WebsiteText inline value={[paragraph]} /></Text>))}

    </Wrapper>
  </section>
  <Video
    src={introductionVideo.src}
    poster={introductionVideo.poster?.id ? websiteImage(introductionVideo.poster,JakeWide).image.src : introductionVideo.poster_path}
    aria-label={introductionVideo.title}
    autoplay={false}
    muted={false}
    loop={false}
    controls={true}
    class="w-full h-auto aspect-video bg-base-50"
  >
    <track src={introductionVideo.captions} kind="captions" srclang="en" label="english_captions" />
  </Video>
  <LandingStats />
  <Cta />
</BaseLayout>
