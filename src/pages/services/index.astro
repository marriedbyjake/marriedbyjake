---
import PublishedImage from "@/components/content/PublishedImage.astro";
import {websiteSection} from '@/lib/website';
import WebsiteText from '@/components/content/WebsiteText.astro';
const section = await websiteSection('services-intro');

// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Components
import ServiceCard from "@/components/services/ServiceCard.astro";
// Content
import { getCollection } from "@/lib/cms";
const allServices = (await getCollection("services"))
  .slice()
  .sort((a, b) => {
    const ao = a.data.order ?? 9999;
    const bo = b.data.order ?? 9999;
    if (ao !== bo) return ao - bo;
    return a.data.title.localeCompare(b.data.title);
  });
---

<BaseLayout
  title="Married By Jake Services"
  description="Explore Jake Smith's personal wedding ceremonies, Christian ceremonies, elopements, destination weddings and Master of Ceremonies services."
>
  <section>
    <Wrapper variant="standard" class="pb-12 pt-48">
      <div class="max-w-xl">
        {section.image?.id && <PublishedImage node={{_type:'image',asset:{_ref:section.image.id},alt:section.image.alt||section.heading}}/>}
<Text
          tag="h1"
          variant="displayLG"
          class="text-accent-800 font-display text-balance"
        >{section.eyebrow && <span class="block text-sm font-sans mb-2">{section.eyebrow}</span>}{section.heading}</Text>
        <Text
          tag="p"
          variant="textSM"
          class="text-base-600 leading-relaxed border-accent-500 mt-2"
        ><WebsiteText inline value={[section.body[0]]} /></Text>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 mt-12 lg:mt-24 gap-8">
        {allServices.map((service) => <ServiceCard post={service} headingTag="h2" />)}
      </div>
    </Wrapper>
  </section>
</BaseLayout>
