---
import PublishedImage from "@/components/content/PublishedImage.astro";
import {websiteSection} from '@/lib/website';
import WebsiteText from '@/components/content/WebsiteText.astro';
const section = await websiteSection('brisbane-details');

// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
// Sections
import Hero from "@/components/landing/HeroBrisbane.astro";
import LandingStats from "@/components/landing/LandingStats.astro";
import Philosophy from "@/components/landing/Philosophy.astro";
import Aproach from "@/components/landing/Aproach.astro";
import Cta from "@/components/global/Cta.astro";
import VideoShowcase from "@/components/landing/VideoShowcase.astro";
import { Image } from "astro:assets";
import JakeWide from "@/images/jake-wide-1.jpg";
import ContextualReviews from "@/components/testimonials/ContextualReviews.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import Text from "@/components/fundations/elements/Text.astro";
---

<BaseLayout navTransparent={true} title="Brisbane Wedding Celebrant - Married By Jake - Jake Smith" description="Warm, calm Brisbane wedding celebrant crafting meaningful ceremonies across the CBD, New Farm, City Botanic Gardens, Howard Smith Wharves, The Calile, Lightspace, Brisbane Powerhouse and beyond." ogType="website" canonical="/brisbane">
  <link slot="head" rel="preload" as="image" href="/images/calile-poster.webp" type="image/webp" fetchpriority="high" />
  <Hero />
  <VideoShowcase />
  <LandingStats />
  <section>
    <Wrapper variant="standard" class="py-12">
      <div class="max-w-3xl">
        {section.image?.id && <PublishedImage node={{_type:'image',asset:{_ref:section.image.id},alt:section.image.alt||section.heading}}/>}
<Text tag="h2" variant="displayLG" class="text-accent-800 font-display text-balance">{section.eyebrow && <span class="block text-sm font-sans mb-2">{section.eyebrow}</span>}{section.heading}</Text>
        <Text tag="p" variant="textSM" class="text-base-600 mt-2"><WebsiteText inline value={[section.body[0]]} /></Text>
      </div>
    </Wrapper>
  </section>
  
  <Philosophy />
  <ContextualReviews context="brisbane" />
  <Aproach />
  <section>
    <Image
      src={JakeWide}
      alt="Jake Smith, Brisbane Wedding Celebrant"
      width={1451}
      height={967}
      class="w-full h-[40dvh] lg:h-[120dvh] object-cover object-center bg-base-50"
    />
  </section>

  <Cta />
</BaseLayout>
