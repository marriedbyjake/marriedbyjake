---
import {websiteSection,websiteImage} from "@/lib/website";
import WebsiteText from "@/components/content/WebsiteText.astro";
const pricingPage=await websiteSection("pricing-page");
const siteImages=await websiteSection("site-images");
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import Button from "@/components/fundations/elements/Button.astro";
import { Image } from "astro:assets";
import HeroImage from "@/images/jake-flowers.jpg";
import { getPricing, extractPrice } from "@/lib/pricing";
const { australianCeremonies, internationalCeremonies, mc } = await getPricing();

const offers = [
  {
    "@type": "Offer",
    name: australianCeremonies.title,
    description: australianCeremonies.description,
    price: extractPrice(australianCeremonies.price),
    priceCurrency: "AUD",
    availability: "https://schema.org/InStock",
    areaServed: { "@type": "Country", name: "Australia" },
    url: "https://marriedbyjake.com/serviceandprice",
  },
  {
    "@type": "Offer",
    name: internationalCeremonies.title,
    description: internationalCeremonies.description,
    price: extractPrice(internationalCeremonies.price),
    priceCurrency: "AUD",
    availability: "https://schema.org/InStock",
    url: "https://marriedbyjake.com/serviceandprice",
  },
  {
    "@type": "Offer",
    name: mc.title,
    description: mc.description,
    price: extractPrice(mc.price),
    priceCurrency: "AUD",
    availability: "https://schema.org/InStock",
    url: "https://marriedbyjake.com/serviceandprice",
  },
].map((o) => (o.price === null ? { ...o, price: undefined } : o));

const lowPrice = Math.min(
  ...offers.map((o) => o.price).filter((p): p is number => typeof p === "number"),
);

const pricingJsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": "https://marriedbyjake.com/serviceandprice#offers",
  name: "Wedding Celebrant Services",
  description:
    "Wedding celebrant ceremonies, elopements and Master of Ceremonies services with Jake Smith.",
  provider: { "@id": "https://marriedbyjake.com/#business" },
  areaServed: [
    { "@type": "Country", name: "Australia" },
    { "@type": "City", name: "Brisbane" },
    { "@type": "City", name: "Sydney" },
    { "@type": "City", name: "Byron Bay" },
    { "@type": "City", name: "Gold Coast" },
    { "@type": "City", name: "Sunshine Coast" },
  ],
  offers: {
    "@type": "AggregateOffer",
    priceCurrency: "AUD",
    lowPrice,
    offerCount: offers.length,
    offers,
  },
};

const ogImage = {
  url: HeroImage.src,
  alt: "Jake Smith — Wedding Celebrant",
  width: HeroImage.width,
  height: HeroImage.height,
  type: "image/jpeg",
};
const currentYear = new Date().getFullYear();
---

<BaseLayout title="Wedding Celebrant Service and Price" description="Clear, professional wedding celebrant services and fees. MC option available." canonical="/serviceandprice" image={ogImage}>
  <section>
    <Wrapper variant="paddingLess">
      <div class="relative overflow-hidden">
        <Image
          src={websiteImage(siteImages.pricing,HeroImage).image}
          alt="Jake Smith — Wedding Celebrant"
          width={1440}
          height={900}
          loading="eager"
          decoding="async"
          class="object-cover object-center w-full h-[40dvh] lg:h-[60dvh] bg-base-50"
        />
        <div aria-hidden="true" class="absolute inset-0 pointer-events-none bg-accent-950/30"></div>
      </div>
    </Wrapper>

    <Wrapper variant="standard" class="pb-12 pt-48">
      <div class="max-w-2xl">
        <Text tag="h1" variant="displayLG" class="text-accent-800 font-display text-balance">{pricingPage.heading}</Text>
        <Text tag="p" variant="textSM" class="text-base-600 mt-2"><WebsiteText inline value={pricingPage.tagline} /></Text>
        <Text tag="p" variant="textSM" class="text-base-600 mt-6"><WebsiteText inline value={pricingPage.introduction} /></Text>
        <Text tag="p" variant="textSM" class="text-base-600 mt-2"><WebsiteText inline value={pricingPage.review_introduction} /></Text>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 mt-12 lg:mt-24">
        <div>
          <Text tag="h2" variant="displaySM" class="text-accent-800 font-display">{pricingPage.excluded_heading}</Text>
          <ul class="list-disc space-y-1 list-inside mt-4 pt-4 border-t border-base-100">{pricingPage.excluded_items.split('\n').filter(Boolean).map((item:string)=><li class="text-base-600 text-sm">{item}</li>)}</ul>
        </div>
        <div>
          <Text tag="h2" variant="displaySM" class="text-accent-800 font-display">{pricingPage.included_heading}</Text>
          <ul class="list-disc space-y-1 list-inside mt-4 pt-4 border-t border-base-100">{pricingPage.included_items.split('\n').filter(Boolean).map((item:string)=><li class="text-base-600 text-sm">{item}</li>)}</ul>
          <Text tag="p" variant="textXS" class="text-base-500 mt-3"><WebsiteText inline value={pricingPage.travel_note} /></Text>
        </div>
      </div>

      <div class="bg-base-50 p-8 lg:p-12 mt-12 lg:mt-24">
        <Text tag="h2" variant="displaySM" class="text-accent-800 font-display">{currentYear} fees</Text>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mt-6">
          <div>
            <Text tag="h3" variant="textXL" class="text-base-800 font-display">{australianCeremonies.title}</Text>
            <Text tag="p" variant="textSM" class="text-base-600 mt-1">{australianCeremonies.price}. {australianCeremonies.description}</Text>
          </div>
          <div>
            <Text tag="h3" variant="textXL" class="text-base-800 font-display">{internationalCeremonies.title}</Text>
            <Text tag="p" variant="textSM" class="text-base-600 mt-1">{internationalCeremonies.description} Pricing typically ranges {internationalCeremonies.price}.</Text>
            <div class="mt-3">
              <Button isLink={true} href="/blog/destination-weddings-how" variant="muted" size="xs" class="w-full lg:w-fit">Read about destination weddings</Button>
            </div>
          </div>
        </div>
        <Text tag="p" variant="textSM" class="text-base-600 mt-6"><WebsiteText inline value={pricingPage.quote_note} /></Text>
        <Text tag="p" variant="textSM" class="text-base-600 mt-3">Here’s <a href="/celebrantcost" class="underline underline-offset-4">what goes into a celebrant’s fee</a>.</Text>
      </div>

      <div class="bg-white p-8 lg:p-12 mt-12">
        <Text tag="h2" variant="displaySM" class="text-accent-800 font-display">{mc.title}</Text>
        <Text tag="p" variant="textSM" class="text-base-600 mt-2">{mc.description}</Text>
        <Text tag="p" variant="textSM" class="text-base-600 mt-2">Typical MC pricing: {mc.price}.</Text>
        <div class="mt-3 flex flex-col lg:flex-row gap-2">
          <Button isLink={true} href="/master-of-ceremonies" variant="default" size="xs" class="w-full lg:w-fit">Find out more</Button>
          <Button isLink={true} href="/contact" variant="muted" size="xs" class="w-full lg:w-fit">Request an MC quote</Button>
        </div>
      </div>

      <div class="bg-base-50 p-8 lg:p-12 mt-12">
        <Text tag="h2" variant="displaySM" class="text-accent-800 font-display">{pricingPage.booking_heading}</Text>
        <ul class="list-disc space-y-1 list-inside mt-4 pt-4 border-t border-base-100">{pricingPage.booking_steps.split('\n').filter(Boolean).map((item:string)=><li class="text-base-600 text-sm">{item}</li>)}</ul>
        <Text tag="p" variant="textSM" class="text-base-600 mt-6"><WebsiteText inline value={pricingPage.booking_note} /></Text>
        <div class="mt-3">
          <Button isLink={true} href="/faq" variant="muted" size="xs" class="w-full lg:w-fit">Read FAQs</Button>
        </div>
      </div>

      <div class="bg-white p-8 lg:p-12 mt-12">
        <Text tag="h2" variant="displaySM" class="text-accent-800 font-display">{pricingPage.next_heading}</Text>
        <Text tag="p" variant="textSM" class="text-base-600 mt-2"><WebsiteText inline value={pricingPage.next_text} /></Text>
        <div class="mt-3">
          <Button isLink={true} href="/contact" variant="default" size="sm" class="w-full lg:w-fit">Enquire Now</Button>
        </div>
      </div>
    </Wrapper>
  </section>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(pricingJsonLd, null, 2).replace(/</g, "\\u003c")}
  />
</BaseLayout>

