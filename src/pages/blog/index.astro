---
import PublishedImage from "@/components/content/PublishedImage.astro";
import {websiteSection} from '@/lib/website';
import WebsiteText from '@/components/content/WebsiteText.astro';
const section = await websiteSection('blog-intro');

// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Components
import BigBlogCard from "@/components/blog/BigBlogCard.astro";
import SmallBlogCard from "@/components/blog/SmallBlogCard.astro";
// Content
import { getCollection } from "@/lib/cms";
const allPosts = await getCollection("posts");
allPosts.sort((a, b) => {
  const dateA = new Date(a.data.pubDate).getTime(); // Convert to timestamp
  const dateB = new Date(b.data.pubDate).getTime(); // Convert to timestamp
  return dateB - dateA; // Compare timestamps
});
---

<BaseLayout
  title="Married By Jake — Wedding Tips and Blog"
  description="Practical wedding advice from celebrant Jake Smith, covering ceremonies, vows, timing, planning, suppliers and calm preparation for the day."
>
  <section>
    <Wrapper variant="standard" class="pb-12 pt-48">
      <div class="text-center max-w-xl mx-auto">
        {section.image?.id && <PublishedImage node={{_type:'image',asset:{_ref:section.image.id},alt:section.image.alt||section.heading}}/>}
<Text
          tag="h1"
          variant="displayXL"
          class="text-accent-800 font-display text-balance"
        >{section.eyebrow && <span class="block text-sm font-sans mb-2">{section.eyebrow}</span>}{section.heading}</Text>
        <Text
          tag="p"
          variant="textBase"
          class="text-base-600 leading-relaxed border-accent-500 mt-2 lg:text-balance"
        ><WebsiteText inline value={[section.body[0]]} /></Text>
      </div>
      <div class="flex flex-col mt-12 lg:mt-24 gap-8">
        {allPosts.slice(0, 1).map((post) => <BigBlogCard post={post} headingTag="h2" />)}
      </div>
      <div class="grid grid-cols-1 lg:grid-cols-3 mt-8 gap-8">
        {allPosts.slice(1).map((post) => <SmallBlogCard post={post} headingTag="h2" />)}
      </div>
    </Wrapper>
  </section>
</BaseLayout>
