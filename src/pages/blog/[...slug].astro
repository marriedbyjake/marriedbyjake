---
import BlogLayout from "@/layouts/BlogLayout.astro";
import { getCollection, getEntry } from "@/lib/cms";
import { PortableText } from "emdash/ui";
export async function getStaticPaths() {
  return (await getCollection("posts")).map(entry => ({ params: { slug: entry.id } }));
}
const entry = await getEntry("posts", Astro.params.slug || "");
if (!entry) throw new Error("Missing published post");
---
<BlogLayout frontmatter={entry.data} slug={entry.id}>
  <PortableText value={entry.content} />
</BlogLayout>
