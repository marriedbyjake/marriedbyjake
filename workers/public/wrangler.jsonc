{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "marriedbyjake-public",
  "account_id": "60ef6bd2c48d5beb6fd6a093cff863cf",
  "main": "../../src/public-worker.ts",
  "compatibility_date": "2026-10-17",
  "assets": {
    "directory": "../../dist/client",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "404-page"
  },
  "services": [{ "binding": "CMS", "service": "marriedbyjake" }],
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    { "pattern": "marriedbyjake.com/*", "zone_id": "240f3283c1efa4405979f3bda0c5896e" },
    { "pattern": "www.marriedbyjake.com/*", "zone_id": "240f3283c1efa4405979f3bda0c5896e" }
  ],
  "observability": { "enabled": true, "head_sampling_rate": 1, "redact_query_string": true }
}
