                "text": "Enquiries and Bookings"
              }
            ],
            "style": "h3"
          },
          {
            "_key": "key-10-g97ko",
            "_type": "block",
            "children": [
              {
                "_key": "key-9-05i5y",
                "_type": "span",
                "text": "Submitting an enquiry does not secure a wedding booking."
              }
            ],
            "style": "normal"
          },
          {
            "_key": "key-12-1a9rt",
            "_type": "block",
            "children": [
              {
                "_key": "key-11-nk5f4",
                "_type": "span",
                "text": "A wedding date is only confirmed once Jake has accepted the booking and all required steps—such as payment of any booking fee and completion of legal documentation—have been finalised."
              }
            ],
            "style": "normal"
          },
          {
            "_key": "key-14-u2fb2",
            "_type": "block",
            "children": [
              {
                "_key": "key-13-m2x6e",
                "_type": "span",
                "text": "Legal Ceremonies"
              }
            ],
            "style": "h3"
          },
          {
            "_key": "key-16-oei2s",
            "_type": "block",
            "children": [
              {
                "_key": "key-15-5agph",
                "_type": "span",
                "text": "All legal marriage services are performed in accordance with the Marriage Act 1961 (Cth). Couples must meet identification requirements, lodge the Notice of Intended Marriage within the statutory timeframe, and comply with all legal conditions for their marriage to be recognised in Australia."
              }
            ],
            "style": "normal"
          },
