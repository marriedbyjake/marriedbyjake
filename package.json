{
  "name": "@unpopular/carrington-jake",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "check": "npm run types && astro check",
    "validate": "npm run test:content && npm run test:publishing && npm run test:publishing:runtime && npm run check && npm run build",
    "preview": "astro preview",
    "astro": "astro",
    "build:locations": "node scripts/build-locations.mjs",
    "deploy": "npm run validate && node scripts/deploy-static.mjs",
    "cms:prepare": "node scripts/prepare-cms.mjs",
    "cms:validate": "emdash seed seed/seed.json --validate",
    "types": "wrangler types --include-runtime false && wrangler types --config workers/public/wrangler.jsonc --env-file /dev/null --env-interface PublicEnv --include-runtime false public-worker-configuration.d.ts",
    "cms:access": "node scripts/create-admin-access.mjs",
    "verify:seo": "node scripts/verify-seo.mjs",
    "test:content": "node scripts/test-testimonial-format.mjs && node scripts/test-testimonial-pagination.mjs && node scripts/test-contextual-reviews.mjs && node scripts/test-testimonial-map.mjs && node scripts/test-pricing.mjs && node scripts/test-performance.mjs && node scripts/test-indexnow.mjs",
    "indexnow": "node scripts/submit-indexnow.mjs",
    "postdeploy": "npm run indexnow",
    "prebuild": "node scripts/verify-published.mjs",
    "test:publishing": "node --test scripts/tests/*.test.mjs",
    "postbuild": "node scripts/verify-static-build.mjs && node scripts/build-public.mjs && node --test scripts/integration/public-delivery-runtime.mjs",
    "build:public-pilot": "node scripts/build-public-pilot.mjs",
    "test:public-pilot": "node --test scripts/integration/public-pilot-runtime.mjs",
    "test:publishing:runtime": "node --test scripts/integration/publishing-runtime.mjs",
    "deploy:ci": "node scripts/deploy-static.mjs",
    "deploy:public:ci": "node scripts/deploy-static.mjs public",
    "postdeploy:public:ci": "npm run indexnow"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.0",
    "@astrojs/react": "^7.1.0",
    "@emdash-cms/cloudflare": "^1.1.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "emdash": "^1.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-scrollbar-hide": "^4.0.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.3.3",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@cloudflare/workers-types": "^5.20261016.1",
    "@emdash-cms/auth": "^1.1.0",
    "@emdash-cms/gutenberg-to-portable-text": "^1.1.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.0",
    "gray-matter": "^4.0.3",
    "kysely": "^0.29.6",
    "kysely-d1": "^0.4.0",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "wrangler": "^4.151.0",
    "miniflare": "5.20261012.0-beta",
    "esbuild": "0.28.2"
  },
  "type": "module",
  "emdash": {
    "seed": "seed/seed.json"
  }
}
